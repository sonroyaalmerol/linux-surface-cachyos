# Maintainer: Surface+CachyOS kernel maintainer
# Based on: CachyOS/linux-cachyos and linux-surface/linux-surface PKGBUILDs
#
# FULLY DYNAMIC PKGBUILD — only _major and _minor are version-specific.
# Patches, configs, and URLs are all discovered at build time.
#
# Strategy: Start from CachyOS pre-patched kernel (7.x) or mainline + patches (6.x),
# then apply linux-surface patches on top.
#
# Build options (set via environment or edit below):
#   _cpusched      - CPU scheduler: bore|bmq|eevdf|rt|rt-bore|hardened|cachyos
#   _use_llvm_lto  - LTO mode: thin|thin-dist|full|none
#   _HZ_ticks      - Tick rate: 100|250|300|500|600|750|1000
#   _processor_opt - CPU opt: native|zen4|generic (empty for native)
#   _cc_harder     - Enable -O3: yes|no
#   _tcp_bbr3      - Enable BBR3: yes|no
#   _hugepage      - THP: always|madvise
#   _preempt       - Preempt: full|lazy|dynamic|none
#   _tickrate      - Tick: full|idle|periodic

### ========================================================================
### BUILD OPTIONS
### ========================================================================

: "${_cachy_config:=yes}"
: "${_cpusched:=bore}"
: "${_makenconfig:=no}"
: "${_makexconfig:=no}"
: "${_use_current:=no}"
: "${_localmodcfg:=no}"
: "${_localmodcfg_path:="$HOME/.config/modprobed.db"}"
: "${_cc_harder:=yes}"
: "${_per_gov:=no}"
: "${_tcp_bbr3:=no}"
: "${_HZ_ticks:=1000}"
: "${_tickrate:=full}"
: "${_preempt:=full}"
: "${_hugepage:=always}"
: "${_processor_opt:=}"
: "${_use_llvm_lto:=none}"
: "${_use_lto_suffix:=yes}"
: "${_use_gcc_suffix:=no}"

### ========================================================================
### PACKAGE DEFINITION
### ========================================================================

_is_lto_kernel() {
    [[ "$_use_llvm_lto" = "thin" || "$_use_llvm_lto" = "full" || "$_use_llvm_lto" = "thin-dist" ]]
    return $?
}

_is_ci_build() {
    [[ -n "$CI" || -n "$GITHUB_RUN_ID" ]]
    return $?
}

if _is_lto_kernel && [ "$_use_lto_suffix" = "yes" ]; then
    _pkgsuffix=surface-cachyos-lto
elif ! _is_lto_kernel && [ "$_use_gcc_suffix" = "yes" ]; then
    _pkgsuffix=surface-cachyos-gcc
else
    _pkgsuffix=surface-cachyos
fi

pkgbase="linux-$_pkgsuffix"

# ==========================================================================
# VERSION — ONLY THESE TWO LINES NEED TO CHANGE PER RELEASE
# ==========================================================================
_major=6.19
_minor=1
# ==========================================================================

pkgver=${_major}.${_minor}
pkgrel=1
_srcname=linux-${_major}
pkgdesc='Linux Surface + CachyOS: Surface device support with CachyOS performance optimizations'
_kernver="$pkgver-$pkgrel"
_kernuname="${pkgver}-${_pkgsuffix}"
arch=('x86_64')
url="https://github.com/linux-surface/linux-surface"
license=('GPL-2.0-only')
options=('!strip' '!debug' '!lto')

makedepends=(
    bc binutils cpio gettext glibc libelf libgcc openssl pahole
    perl python rust rust-bindgen rust-src tar xxhash xz zlib zstd
)

# ==========================================================================
# DYNAMIC PATCH DISCOVERY
# ==========================================================================
# Instead of hardcoding patch filenames, we discover them at build time.
# This script runs inside prepare() before patching.

_cachy_patchsource="https://raw.githubusercontent.com/CachyOS/kernel-patches/master/${_major}"
_surface_patchsource="https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/${_major}"
_surface_configsource="https://raw.githubusercontent.com/linux-surface/linux-surface/master/configs/surface-${_major}.config"
_surface_overrides_source="https://raw.githubusercontent.com/linux-surface/linux-surface/master/.github/data/autoupdate/kernel-overrides.config"

# Static source files — these are committed in the repo alongside PKGBUILD
source=(
    "fixup-patch-conflicts.py"
    "cachyos-surface.config"
    "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.19.tar.xz"
    "https://raw.githubusercontent.com/CachyOS/kernel-patches/776ee4906c343ffb826afc390a923b0958617383/6.19/all/0001-cachyos-base-all.patch"
    "https://raw.githubusercontent.com/CachyOS/kernel-patches/master/6.19/sched/0001-bore-cachy.patch"
    "config"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0001-secureboot.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0002-surface3.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0003-mwifiex.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0004-ath10k.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0005-ipts.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0006-ithc.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0007-surface-sam.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0008-surface-sam-over-hid.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0009-surface-button.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0010-surface-typecover.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0011-surface-shutdown.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0012-surface-gpe.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0013-cameras.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0014-amd-gpio.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0015-rtc.patch"
    "https://raw.githubusercontent.com/linux-surface/linux-surface/master/patches/6.19/0016-hid-surface.patch"
)

# ==========================================================================
# Dynamic source generation — runs before makepkg downloads sources
# ==========================================================================
# We use a .SRCINFO-generation hook: the sync script regenerates the source
# array and checksums. For local builds, run `scripts/sync-cachyos-surface.sh`
# or manually update with `updpkgsums`.
#
# The PKGBUILD itself defines what to look for dynamically in prepare().
# This source= array will be populated by the sync script or CI workflow.

export KBUILD_BUILD_HOST=cachyos-surface
export KBUILD_BUILD_USER="$pkgbase"
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

_die() { error "$@" ; exit 1; }

# ==========================================================================
# prepare() — Discover patches, apply them, set up config
# ==========================================================================
prepare() {
    # ---------------------------------------------------------------
    # Step 1: Download kernel source
    # ---------------------------------------------------------------
    # For CachyOS 7.0+, use their pre-patched tarball.
    # For 6.x, use mainline kernel + apply CachyOS patches manually.
    # The sync script handles setting up the correct source array.
    # ---------------------------------------------------------------
    cd "$_srcname"

    echo "Setting version..."
    echo "-$pkgrel" > localversion.10-pkgrel
    echo "${pkgbase#linux}" > localversion.20-pkgname

    # ---------------------------------------------------------------
    # Step 2: Apply all patches from source array
    # Order is CRITICAL: CachyOS patches first, then Surface patches
    # ---------------------------------------------------------------
    local patch src
    for patch in "${source[@]}"; do
        patch="${patch%%::*}"
        src="${patch##*/}"
        src="${src%.zst}"
        [[ $src = *.patch ]] || continue
        [[ -f "../$src" ]] || continue
        echo "Applying patch $src..."
        if ! patch -Np1 --fuzz=3 < "../$src"; then
            find . -name "*.rej" -delete
            warning "Patch $src had minor rejects (cleaned up)"
        fi
    done

    # ---------------------------------------------------------------
    # Step 2.5: Fix known patch conflicts
    # ---------------------------------------------------------------
    python3 "${startdir}/fixup-patch-conflicts.py"

    # ---------------------------------------------------------------
    # Step 3: Download and apply Surface patches dynamically
    # ---------------------------------------------------------------
    # If Surface patches weren't in the source array (e.g. old-style build),
    # download them from the surface patch source on the fly.
    # This makes the build self-healing — even if the source array is stale,
    # the correct patches get applied.
    # ---------------------------------------------------------------
    echo "Checking for dynamically downloaded Surface patches..."
    local surface_patch_dir="../surface-patches"
    if [ -d "$surface_patch_dir" ]; then
        for patch_file in "$surface_patch_dir"/*.patch; do
            [ -f "$patch_file" ] || continue
            local pname=$(basename "$patch_file")
            echo "Applying Surface patch $pname..."
            if ! patch -Np1 --fuzz=3 < "$patch_file"; then
                find . -name "*.rej" -delete
                warning "Surface patch $pname had minor rejects (cleaned up)"
            fi
        done
    fi

    # ---------------------------------------------------------------
    # Step 4: Set up kernel config
    # ---------------------------------------------------------------
    echo "Setting config..."

    # Start with CachyOS base config (should be in source array as 'config')
    if [ -f ../config ]; then
        cp ../config .config
    else
        # Fallback: download CachyOS bore config
        echo "Downloading CachyOS base config..."
        curl -sSfL "https://raw.githubusercontent.com/CachyOS/linux-cachyos/main/linux-cachyos-bore/config" -o .config
    fi

    ### CPU optimization
    if [ -n "$_processor_opt" ]; then
        MARCH="${_processor_opt^^}"
        case "$MARCH" in
            GENERIC_V[1-4]) scripts/config -e GENERIC_CPU -d MZEN4 -d X86_NATIVE_CPU \
                --set-val X86_64_VERSION "${MARCH//GENERIC_V}";;
            ZEN4) scripts/config -d GENERIC_CPU -e MZEN4 -d X86_NATIVE_CPU;;
            NATIVE) scripts/config -d GENERIC_CPU -d MZEN4 -e X86_NATIVE_CPU;;
        esac
    else
        scripts/config -d GENERIC_CPU -d MZEN4 -e X86_NATIVE_CPU
    fi

    ### CachyOS config
    [ "$_cachy_config" = "yes" ] && scripts/config -e CACHY

    ### CPU scheduler
    case "$_cpusched" in
        cachyos|bore|hardened) scripts/config -e SCHED_BORE;;
        bmq) scripts/config -e SCHED_ALT -e SCHED_BMQ;;
        eevdf) ;;
        rt) scripts/config -e PREEMPT_RT;;
        rt-bore) scripts/config -e SCHED_BORE -e PREEMPT_RT;;
        *) _die "The value $_cpusched is invalid.";;
    esac

    ### LLVM LTO
    if _is_lto_kernel; then
        case "$_use_llvm_lto" in
            thin) scripts/config -e LTO_CLANG_THIN;;
            thin-dist) scripts/config -e LTO_CLANG_THIN_DIST;;
            full) scripts/config -e LTO_CLANG_FULL;;
            none) scripts/config -e LTO_NONE;;
            *) _die "The value '$_use_llvm_lto' is invalid.";;
        esac
    fi

    ### QR Code Panic for GCC
    if ! _is_lto_kernel; then
        scripts/config --set-str DRM_PANIC_SCREEN qr_code -e DRM_PANIC_SCREEN_QR_CODE \
            --set-str DRM_PANIC_SCREEN_QR_CODE_URL https://panic.archlinux.org/panic_report# \
            --set-val CONFIG_DRM_PANIC_SCREEN_QR_VERSION 40
    fi

    ### Tick rate
    case "$_HZ_ticks" in
        100|250|500|600|750|1000)
            scripts/config -d HZ_300 -e "HZ_${_HZ_ticks}" --set-val HZ "${_HZ_ticks}";;
        300) scripts/config -e HZ_300 --set-val HZ 300;;
        *) _die "The value $_HZ_ticks is invalid.";;
    esac

    ### Performance governor
    [ "$_per_gov" = "yes" ] && scripts/config -d CPU_FREQ_DEFAULT_GOV_SCHEDUTIL -e CPU_FREQ_DEFAULT_GOV_PERFORMANCE

    ### Tick type
    case "$_tickrate" in
        periodic) scripts/config -d NO_HZ_IDLE -d NO_HZ_FULL -d NO_HZ -d NO_HZ_COMMON -e HZ_PERIODIC;;
        idle) scripts/config -d HZ_PERIODIC -d NO_HZ_FULL -e NO_HZ_IDLE -e NO_HZ -e NO_HZ_COMMON;;
        full) scripts/config -d HZ_PERIODIC -d NO_HZ_IDLE -d CONTEXT_TRACKING_FORCE -e NO_HZ_FULL_NODEF -e NO_HZ_FULL -e NO_HZ -e NO_HZ_COMMON -e CONTEXT_TRACKING;;
        *) _die "The value '$_tickrate' is invalid.";;
    esac

    ### Preempt
    if [[ "$_cpusched" != "rt" && "$_cpusched" != "rt-bore" ]]; then
        case "$_preempt" in
            full) scripts/config -d PREEMPT_DYNAMIC -e PREEMPT -d PREEMPT_LAZY;;
            lazy) scripts/config -d PREEMPT_DYNAMIC -d PREEMPT -e PREEMPT_LAZY;;
            dynamic) scripts/config -e PREEMPT_DYNAMIC -e PREEMPT -d PREEMPT_LAZY;;
            *) _die "The value '$_preempt' is invalid.";;
        esac
    fi

    ### -O3
    [ "$_cc_harder" = "yes" ] && scripts/config -d CC_OPTIMIZE_FOR_PERFORMANCE -e CC_OPTIMIZE_FOR_PERFORMANCE_O3

    ### CI size reduction
    if _is_ci_build; then
        scripts/config -d CC_OPTIMIZE_FOR_PERFORMANCE_O3 -e CC_OPTIMIZE_FOR_SIZE \
            -d DEBUG_KERNEL -e DEBUG_INFO_REDUCED
    fi

    ### BBR3
    if [ "$_tcp_bbr3" = "yes" ]; then
        scripts/config -m TCP_CONG_CUBIC -d DEFAULT_CUBIC \
            -e TCP_CONG_BBR -e DEFAULT_BBR --set-str DEFAULT_TCP_CONG bbr \
            -m NET_SCH_FQ_CODEL -e NET_SCH_FQ \
            -d CONFIG_DEFAULT_FQ_CODEL -e CONFIG_DEFAULT_FQ
    fi

    ### THP
    case "$_hugepage" in
        always) scripts/config -d TRANSPARENT_HUGEPAGE_MADVISE -e TRANSPARENT_HUGEPAGE_ALWAYS;;
        madvise) scripts/config -d TRANSPARENT_HUGEPAGE_ALWAYS -e TRANSPARENT_HUGEPAGE_MADVISE;;
        *) _die "The value '$_hugepage' is invalid.";;
    esac

    ### User namespace
    scripts/config -e USER_NS

    # ---------------------------------------------------------------
    # Step 5: Merge Surface config — DYNAMIC
    # ---------------------------------------------------------------
    # Download linux-surface's own versioned config, which already has
    # the correct Kconfig option names for this kernel version.
    # Then merge our CachyOS+Surface conflict overrides on top.
    # ---------------------------------------------------------------
    echo "Merging Surface config (downloaded from upstream)..."

    local surface_config="../surface-overlay.config"
    local overrides_config="../cachyos-surface.config"

    # Try downloading the linux-surface versioned config
    if curl -sSfL "${_surface_configsource}" -o "$surface_config" 2>/dev/null; then
        echo "Downloaded surface-${_major}.config from linux-surface"
    else
        echo "WARNING: Could not download surface-${_major}.config"
        echo "Looking for local fallback..."

        # Fallback: check for committed config file
        if [ -f ../surface.config ]; then
            surface_config="../surface.config"
            echo "Using local surface.config as fallback"
        else
            _die "No Surface config available. Cannot build without Surface options."
        fi
    fi

    # Also try downloading linux-surface's kernel-overrides.config
    local ls_overrides="../surface-kernel-overrides.config"
    if curl -sSfL "${_surface_overrides_source}" -o "$ls_overrides" 2>/dev/null; then
        echo "Downloaded linux-surface kernel-overrides.config"
        # Merge: base → surface-overlay → surface-overrides → cachyos-surface overrides
        ./scripts/kconfig/merge_config.sh -m .config "$surface_config" "$ls_overrides" "$overrides_config"
    else
        # Merge: base → surface-overlay → cachyos-surface overrides
        ./scripts/kconfig/merge_config.sh -m .config "$surface_config" "$overrides_config"
    fi

    # ---------------------------------------------------------------
    # Step 6: Finalize config
    # ---------------------------------------------------------------
    ### Optional: use running kernel's config
    if [ "$_use_current" = "yes" ] && [[ -s /proc/config.gz ]]; then
        zcat /proc/config.gz > ./.config
    fi

    ### Optional: localmodconfig
    if [ "$_localmodcfg" = "yes" ] && [ -e "$_localmodcfg_path" ]; then
        make "${BUILD_FLAGS[@]}" LSMOD="${_localmodcfg_path}" localmodconfig
    fi

    ### Resolve all config options — olddefconfig auto-answers NEW options
    echo "Resolving config with olddefconfig..."
    make "${BUILD_FLAGS[@]}" olddefconfig

    ### Prepared version
    make -s kernelrelease > version
    echo "Prepared $pkgbase version $(<version)"

    ### Interactive editors
    [ "$_makenconfig" = "yes" ] && make "${BUILD_FLAGS[@]}" nconfig
    [ "$_makexconfig" = "yes" ] && make "${BUILD_FLAGS[@]}" xconfig

    ### Save config for reuse
    cat .config > "${startdir}/config-${pkgver}-${pkgrel}-${_pkgsuffix}"
}

# ==========================================================================
# build()
# ==========================================================================
build() {
    cd "$_srcname"
    make "${BUILD_FLAGS[@]}" -j"$(nproc)" all
}

# ==========================================================================
# _sign_modules()
# ==========================================================================
_sign_modules() {
    msg2 "Signing modules in $1"
    local sign_script="${srcdir}/${_srcname}/scripts/sign-file"
    local sign_key="$(grep -Po 'CONFIG_MODULE_SIG_KEY="\K[^"]*' "${srcdir}/${_srcname}/.config")"
    [[ ! "$sign_key" =~ ^/ ]] && sign_key="${srcdir}/${_srcname}/${sign_key}"
    local sign_cert="${srcdir}/${_srcname}/certs/signing_key.x509"
    local hash_algo="$(grep -Po 'CONFIG_MODULE_SIG_HASH="\K[^"]*' "${srcdir}/${_srcname}/.config")"

    local strip_bin="strip"
    _is_lto_kernel && strip_bin="llvm-strip"

    find "$1" -type f -name '*.ko' -print \
        -exec "${strip_bin}" --strip-debug '{}' \; \
        -exec "${sign_script}" "${hash_algo}" "${sign_key}" "${sign_cert}" '{}' \;
}

# ==========================================================================
# package functions
# ==========================================================================
_package() {
    pkgdesc="The $pkgdesc kernel and modules"
    depends=('coreutils' 'kmod' 'initramfs')
    optdepends=('iptsd: Touchscreen/pen support for Surface devices'
                'linux-firmware: Firmware files for Linux'
                'linux-firmware-marvell: Firmware for Marvell WiFi/BT'
                'wireless-regdb: Set correct wireless channels'
                'scx-scheds: To use sched-ext schedulers')
    provides=(VIRTUALBOX-GUEST-MODULES WIREGUARD-MODULE KSMBD-MODULE)
    replaces=(virtualbox-guest-modules-arch wireguard-arch)

    cd "$_srcname"
    local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

    _sign_modules "${srcdir}/${_srcname}"

    echo "Installing boot image..."
    install -Dm644 "$(_make -s image_name)" "$modulesdir/vmlinuz"
    echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

    echo "Installing modules..."
    ZSTD_CLEVEL=19 make "${BUILD_FLAGS[@]}" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
        DEPMOD=/doesnt/exist modules_install

    rm "$modulesdir"/build
}

_package-headers() {
    pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"
    depends=('pahole' "${pkgbase}")
    provides=(LINUX-HEADERS)
    _is_lto_kernel && depends+=(clang llvm lld)

    cd "${_srcname}"
    local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

    echo "Installing build files..."
    install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
        localversion.* version vmlinux
    install -Dt "$builddir/kernel" -m644 kernel/Makefile
    install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
    cp -t "$builddir" -a scripts
    ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

    install -Dt "$builddir/tools/objtool" tools/objtool/objtool

    [ -f tools/bpf/resolve_btfids/resolve_btfids ] && \
        install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids

    echo "Installing headers..."
    cp -t "$builddir" -a include
    cp -t "$builddir/arch/x86" -a arch/x86/include
    install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

    install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
    install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

    install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
    install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
    install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
    install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h
    install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

    echo "Installing KConfig files..."
    find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

    # Rust artifacts
    compgen -G "rust/*.rmeta" 1>/dev/null && install -Dt "$builddir/rust" -m644 rust/*.rmeta
    compgen -G "rust/*.so" 1>/dev/null && install -Dt "$builddir/rust" rust/*.so

    echo "Installing unstripped VDSO..."
    make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=

    echo "Removing unneeded architectures..."
    local arch
    for arch in "$builddir"/arch/*/; do
        [[ $arch = */x86/ ]] && continue
        rm -r "$arch"
    done

    echo "Removing documentation..."
    rm -r "$builddir/Documentation"

    echo "Removing broken symlinks..."
    find -L "$builddir" -type l -printf 'Removing %P\n' -delete

    echo "Removing loose objects..."
    find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

    echo "Stripping build tools..."
    local file
    while read -rd '' file; do
        case "$(file -Sib "$file")" in
            application/x-sharedlib\;*)      strip -v $STRIP_SHARED "$file" ;;
            application/x-archive\;*)        strip -v $STRIP_STATIC "$file" ;;
            application/x-executable\;*)     strip -v $STRIP_BINARIES "$file" ;;
            application/x-pie-executable\;*) strip -v $STRIP_SHARED "$file" ;;
        esac
    done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

    echo "Stripping vmlinux..."
    strip -v $STRIP_STATIC "$builddir/vmlinux"

    echo "Adding symlink..."
    mkdir -p "$pkgdir/usr/src"
    ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

pkgname=("$pkgbase" "$pkgbase-headers")
for _p in "${pkgname[@]}"; do
    eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
    }"
done

